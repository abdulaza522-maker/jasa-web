datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Order {
  id        String   @id @default(cuid())
  name      String
  contact   String // email atau nomor WhatsApp
  service   String // jenis layanan yang diminta
  budget    String?
  brief     String // kebutuhan website
  createdAt DateTime @default(now())
}
